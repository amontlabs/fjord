{
  "manifest_version": 3,
  "name": "Fjord POC",
  "version": "0.1.0",
  "description": "Reads the visible Claude Code project page and types in its real composer, for Fjord.",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/code/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fjord-poc@amontlabs.dev",
      "strict_min_version": "128.0"
    }
  }
}